# Reference relay. Copy to .env only on your machine; never commit real values.

PORT=8787
HOST=127.0.0.1

# Required for any public deployment. Native clients reject public http:// URLs.
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem

# Required for non-loopback deployments unless RELAY_ALLOW_CLEARTEXT=1.
# When set, browser WebSocket Origin headers that do not match are rejected.
# Native clients that omit Origin are still accepted.
# RELAY_ORIGIN=https://relay.example.invalid

# Reverse proxy that terminates TLS. Trust X-Forwarded-For only behind a proxy you control.
# RELAY_BEHIND_PROXY=1
# RELAY_TRUST_PROXY=1

# Trusted LAN bind without TLS. Do not set this on the public internet.
# HOST=0.0.0.0
# RELAY_ALLOW_CLEARTEXT=1

# Optional durable ciphertext/presence store. Do not point this at a shared public disk
# unless the file mode stays 0600 and the directory is not world-readable.
# RELAY_STATE_PATH=./state/state.json
