<Application x:Class="CodexAccounts.Companion.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3957F2"/>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/></Style>
  </Application.Resources>
</Application>
